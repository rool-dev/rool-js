{
  "name": "@rool-dev/sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for Rool Machines",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/auth-node.js",
      "types": "./dist/auth-node.d.ts"
    }
  },
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "rm -rf dist && tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:v2": "node --env-file=.env --import tsx test/integration/v2/run.ts",
    "notebook": "pnpm build && ./scripts/notebook.sh",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.rool.dev/sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rool-dev/rool-js.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "rool",
    "sdk",
    "api-client"
  ],
  "author": {
    "name": "Rool Limited",
    "email": "info@rool.dev",
    "url": "https://rool.dev"
  },
  "license": "MIT",
  "dependencies": {
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tslab": "^1.0.22",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
