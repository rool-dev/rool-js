{
  "name": "rool-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rool JavaScript SDK and Svelte bindings",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "docs:prebuild": "node docs/build-docs.js",
    "docs:dev": "pnpm run docs:prebuild && astro dev --root docs",
    "docs:build": "pnpm run docs:prebuild && astro build --root docs",
    "docs:preview": "astro preview --root docs",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.5",
    "astro": "^7.1.6",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rool-dev/rool-js.git"
  },
  "author": {
    "name": "Rool",
    "email": "hello@rool.dev",
    "url": "https://rool.dev"
  },
  "license": "MIT"
}
