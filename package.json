{
  "name": "@rool-dev/sdk",
  "version": "2.0.2",
  "description": "TypeScript SDK for Rool Machines",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/auth-node.js",
      "types": "./dist/auth-node.d.ts"
    }
  },
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "rm -rf dist && tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:v2": "node --env-file=.env --import tsx test/integration/v2/run.ts",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "docs:prebuild": "node docs/build-docs.js",
    "docs:dev": "pnpm run docs:prebuild && astro dev --root docs",
    "docs:build": "pnpm run docs:prebuild && astro build --root docs",
    "docs:preview": "astro preview --root docs",
    "release": "node scripts/release.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.rool.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rool-dev/rool-js.git"
  },
  "keywords": [
    "rool",
    "sdk",
    "api-client"
  ],
  "author": {
    "name": "Rool Limited",
    "email": "info@rool.dev",
    "url": "https://rool.dev"
  },
  "license": "MIT",
  "dependencies": {
    "open": "^11.0.1"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@types/node": "^24.13.3",
    "astro": "^7.2.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
